package seleminiprj;

import java.time.Duration;

import org.openqa.selenium.Alert;
import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.support.ui.ExpectedConditions;
import org.openqa.selenium.support.ui.WebDriverWait;

public class trialprj {

    static WebDriver driver;

    static String url = "https://www.demoblaze.com/";

    // Product
    static String product = "//a[contains(@href,'idp_=1')]";

    // Add to cart
    static String cart = "//a[@onclick='addToCart(1)']";

    // Cart button
    static String cartbtn = "//a[@id='cartur']";

    // Place Order
    static String order = "//button[contains(text(),'Place')]";

    // Order form
    static String name = "input[id='name']";
    static String country = "input[id='country']";
    static String city = "input[id='city']";
    static String credit = "input[id='card']";
    static String month = "input[id='month']";
    static String year = "input[id='year']";

    // Purchase
    static String purchase = "//button[text()='Purchase']";

    // Thank you message
    static String heading = "//h2[contains(text(),'Thank')]";

    // OK button
    static String ok = "//button[text()='OK']";


    public static void verifyurl(String part, String page) {

        String acturl = driver.getCurrentUrl();

        if (acturl.contains(part)) {
            System.out.println("PASS - " + page);
        } else {
            System.out.println("FAIL - " + page);
        }
    }


    public static void setup() {

        driver = new ChromeDriver();

        driver.manage().window().maximize();

        driver.manage().timeouts()
              .implicitlyWait(Duration.ofSeconds(10));

        driver.get(url);
    }


    public static void addproduct() {

        driver.findElement(By.xpath(product)).click();

        verifyurl("idp_=1", "Productpage");
    }


    public static void addcart() {

        driver.findElement(By.xpath(cart)).click();

        WebDriverWait wait =
                new WebDriverWait(driver, Duration.ofSeconds(10));

        Alert popup =
                wait.until(ExpectedConditions.alertIsPresent());

        System.out.println("Alert : " + popup.getText());

        popup.accept();
    }


    public static void cartbtn() {

        driver.findElement(By.xpath(cartbtn)).click();

        verifyurl("cart.html", "Cartpage");
    }


    public static void order() {

        driver.findElement(By.xpath(order)).click();
    }


    public static void placeorder() {

        driver.findElement(By.cssSelector(name))
              .sendKeys("Rithu");

        driver.findElement(By.cssSelector(country))
              .sendKeys("India");

        driver.findElement(By.cssSelector(city))
              .sendKeys("Chennai");

        driver.findElement(By.cssSelector(credit))
              .sendKeys("Yes");

        driver.findElement(By.cssSelector(month))
              .sendKeys("November");

        driver.findElement(By.cssSelector(year))
              .sendKeys("2026");
    }


    public static void place() {

        driver.findElement(By.xpath(purchase)).click();

        String Msg =
                driver.findElement(By.xpath(heading)).getText();

        System.out.println(Msg);

        driver.findElement(By.xpath(ok)).click();
    }


    public static void tear() {

        driver.quit();
    }


    public static void main(String[] args) {

        setup();

        addproduct();

        addcart();

        cartbtn();

        order();

        placeorder();

        place();

        tear();
    }
}
